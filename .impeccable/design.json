  "components": [
    {
      "name": "Glass Pane",
      "kind": "card",
      "refersTo": "glass-pane",
      "description": "Liquid Glass container over the sky; lifts, brightens and gains a rim on focus.",
      "html": "<div class=\"ds-sky\"><button class=\"ds-pane\"><span class=\"ds-heading\">HOME</span><span class=\"ds-title\">70° inside</span><span class=\"ds-detail\">Heating to 69°</span></button></div>",
      "css": ".ds-sky{padding:32px;background:linear-gradient(160deg,#1E2148,#B9708A 55%,#EFA06A)}.ds-pane{display:flex;flex-direction:column;gap:6px;align-items:flex-start;width:300px;padding:20px 26px;border:0;border-radius:26px;color:#fff;font:500 18px -apple-system,system-ui,sans-serif;background:rgba(14,16,36,.2);backdrop-filter:blur(30px) saturate(160%);box-shadow:inset 0 1px 0 rgba(255,255,255,.35);transition:transform .35s cubic-bezier(.3,1.3,.5,1),box-shadow .35s}.ds-pane:hover,.ds-pane:focus-visible{outline:none;transform:scale(1.04);background:rgba(255,255,255,.16);box-shadow:inset 0 0 0 2px rgba(255,255,255,.75),0 18px 22px rgba(8,8,24,.45)}.ds-heading{font:600 13px -apple-system,system-ui,sans-serif;letter-spacing:1.1px;color:rgba(255,255,255,.72)}.ds-detail{font-weight:400;font-size:15px;color:rgba(255,255,255,.8)}"
    },
    {
      "name": "Nudge Chip",
      "kind": "chip",
      "refersTo": "nudge-chip",
      "description": "Amber chip for a condition the owner would act on.",
      "html": "<div class=\"ds-sky\"><span class=\"ds-nudge\">Dry air</span></div>",
      "css": ".ds-sky{padding:24px;background:#232A58}.ds-nudge{display:inline-block;padding:5px 11px;border-radius:13px;font:600 15px -apple-system,system-ui,sans-serif;color:#FFE2A8;background:rgba(255,190,90,.18);box-shadow:inset 0 0 0 1px rgba(255,205,120,.4)}"
    },
    {
      "name": "Warning Chip",
      "kind": "chip",
      "refersTo": "warning-chip",
      "description": "Coral chip for a lost connection or failed setup test.",
      "html": "<div class=\"ds-sky\"><span class=\"ds-warn\">Home Assistant offline, retrying</span></div>",
      "css": ".ds-sky{padding:24px;background:#232A58}.ds-warn{display:inline-block;padding:5px 11px;border-radius:13px;font:600 15px -apple-system,system-ui,sans-serif;color:#FFA898;background:rgba(255,90,70,.24);box-shadow:inset 0 0 0 1px rgba(255,140,120,.55)}"
    },
    {
      "name": "Alert Banner",
      "kind": "custom",
      "refersTo": "alert-banner",
      "description": "Weather alert with text exactly as issued and a QR code to the details page.",
      "html": "<div class=\"ds-sky\"><div class=\"ds-alert\"><strong>Severe Thunderstorm Warning</strong><span class=\"ds-meta\">National Weather Service, until 8:15 PM</span><p>Hazards include 60 mph wind gusts and penny size hail.</p></div></div>",
      "css": ".ds-sky{padding:24px;background:#1F2030}.ds-alert{max-width:420px;padding:18px;border-radius:18px;color:#fff;font:400 16px -apple-system,system-ui,sans-serif;background:rgba(255,90,70,.24);box-shadow:inset 0 0 0 1.5px rgba(255,140,120,.55)}.ds-alert strong{display:block;font-weight:500;font-size:22px}.ds-meta{font-size:13px;color:rgba(255,255,255,.8)}.ds-alert p{margin:8px 0 0}"
    },
    {
      "name": "Scene Button",
      "kind": "button",
      "refersTo": "scene-button",
      "description": "Native tvOS glass button; focus is the platform's white platter with dark text.",
      "html": "<div class=\"ds-sky\"><button class=\"ds-scene\">Goodnight</button></div>",
      "css": ".ds-sky{padding:24px;background:linear-gradient(160deg,#1E2148,#B9708A)}.ds-scene{padding:10px 22px;border:0;border-radius:999px;font:500 17px -apple-system,system-ui,sans-serif;color:#fff;background:rgba(255,255,255,.14);backdrop-filter:blur(20px);transition:transform .2s,background .2s,color .2s}.ds-scene:hover,.ds-scene:focus-visible{outline:none;background:#fff;color:#1a1a1a;transform:scale(1.06)}"
    },
    {
      "name": "Status Row",
      "kind": "custom",
      "refersTo": "status-row-well",
      "description": "Icon well, title and detail, with an optional trailing chip.",
      "html": "<div class=\"ds-sky\"><div class=\"ds-row\"><span class=\"ds-well\"></span><span><b>31% humidity</b><small>Bedroom 33%</small></span></div></div>",
      "css": ".ds-sky{padding:24px;background:#232A58}.ds-row{display:flex;align-items:center;gap:12px;color:#fff;font:500 18px -apple-system,system-ui,sans-serif}.ds-well{width:32px;height:32px;border-radius:50%;background:rgba(255,255,255,.14)}.ds-row b{display:block;font-weight:500}.ds-row small{font-size:14px;font-weight:400;color:rgba(255,255,255,.8)}"
    }
  ],
  "narrative": {
    "northStar": "The Window Pane",
    "overview": "The biggest screen in the room becomes a window onto the actual sky. A mesh-gradient sky fills the frame, its colors set by the real condition and the sun's altitude, and a few Liquid Glass panes float over it with the time, the forecast, the house and the code. Everything is read in a glance from the couch, so the system spends its ambition on the sky and on legibility, never on chrome.\n\nThe resting screen is calm: one huge thin clock, one sky, four panes. Motion is slow and continuous, the sky drifting on 34 to 53 second cycles and blending between scenes over about 90 seconds, so nothing moves faster than weather does. The only fast moments are earned: focus lifting a pane when the remote is picked up, a storm swapping the dashboard for radar, a rare flash of lightning.\n\nThe panes use the platform's own Liquid Glass and native tvOS controls. Brand lives in the sky, the thin display numerals, the 40 pt continuous corners and the restraint of the signal colors. The approved mockup (board A, animated gradient) is the composition reference.",
    "keyCharacteristics": [
      "The sky is the color; panes are glass and ink.",
      "White ink at three opacities carries all text.",
      "Each signal color has exactly one job.",
      "SF Pro Thin only at hero scale, Regular to Semibold everywhere else.",
      "Native tvOS focus, lists, fields and glass buttons; custom only where the platform has no equivalent."
    ],
    "rules": [
      {
        "name": "The Sky Is the Color Rule",
        "body": "Large fields of color come only from the scene. No pane, button or heading carries a brand color of its own.",
        "section": "colors"
      },
      {
        "name": "The One Job Rule",
        "body": "Rain blue means rain chance, amber means a nudge, coral means a warning, sunlight means the sun. A color never appears for decoration or a second meaning.",
        "section": "colors"
      },
      {
        "name": "The Shade Follows the Sun Rule",
        "body": "The brighter the sky, the more Glass Shade goes into every pane, so white ink keeps its contrast on a clear afternoon or a snowy morning.",
        "section": "colors"
      },
      {
        "name": "The Thin Hero Rule",
        "body": "Thin and Light weights appear only at 64 pt and above (clock, meridiem, hero temperature, compact storm clock). Below that, Regular is the lightest weight.",
        "section": "typography"
      },
      {
        "name": "The 24-Point Floor Rule",
        "body": "No text role is smaller than 24 pt. The tvOS HIG puts legibility at 23 pt; the mockup's 22 pt captions were raised to 24.",
        "section": "typography"
      },
      {
        "name": "The Tabular Numbers Rule",
        "body": "Temperatures in rows (hourly, daily) use tabular figures so columns do not wobble as values change. The clock stays proportional; it is one line and reads better that way.",
        "section": "typography"
      },
      {
        "name": "The Stacked Actions Rule",
        "body": "Buttons under a field stack vertically. tvOS sends focus to the geometrically nearest control, so a side-by-side row under a wide field sends Down to the wrong button.",
        "section": "layout"
      },
      {
        "name": "The Glass Only Rule",
        "body": "Every container over the sky is Liquid Glass. No opaque cards, no hand-rolled blur, no gradient fills standing in for glass.",
        "section": "elevation"
      },
      {
        "name": "The Flat at Rest Rule",
        "body": "A pane gains shadow, sheen and rim only while it has focus.",
